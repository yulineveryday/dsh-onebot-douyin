{
  "name": "dsh-onebot-douyin",
  "version": "0.3.0",
  "description": "DSH 插件 + OneBot 11 桥：把抖音 / 多闪 个人号接进 DeepSeek Harness，也能给 NoneBot2 / Koishi / AstrBot 用",
  "type": "module",
  "main": "./src/dsh-plugin.js",
  "exports": {
    ".": "./src/dsh-plugin.js",
    "./bridge": "./src/plugin.js",
    "./cli": "./src/cli.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "onebot-douyin": "bin/onebot-douyin.js",
    "obd": "bin/onebot-douyin.js"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "profiles",
    "adapters/android/adapter.py",
    "cordis.patch.yml",
    "config.example.json",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "onebot",
    "onebot11",
    "napcat",
    "douyin",
    "duoshan",
    "qq-bot",
    "chatbot",
    "bridge"
  ],
  "license": "MIT",
  "scripts": {
    "start": "node src/index.js start",
    "doctor": "node src/index.js doctor",
    "test": "node --test --test-isolation=none \"test/*.test.js\"",
    "ctl": "node scripts/ctl.mjs",
    "pack": "npm pack --dry-run"
  },
  "dependencies": {
    "douyin-im": "^1.1.0",
    "ws": "^8.18.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "node": ">=20.18"
    }
  }
}
